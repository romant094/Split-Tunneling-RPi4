# .env.secrets.example — Template for VPN key secrets
#
# Copy this file to .env.secrets and fill in your real 44-character base64 keys.
# NEVER commit .env.secrets — it is gitignored (D-07).
#
# Variable names defined by D-08. Keys are standard WireGuard base64-encoded
# 32-byte values (44 chars: 43 base64 chars + one '=' padding character).
#
# To generate keys (for reference — use keys from your AmneziaWG server config):
#   awg genkey | tee private.key | awg pubkey > public.key
#
# Right-hand sides are intentionally empty so this file is never mistaken for
# a usable secrets file. Fill them in .env.secrets only.

AWG_PRIVATE_KEY=
AWG_PUBLIC_KEY=
AWG_PRESHARED_KEY=
